# Copia este archivo a .env y completa tus datos. NO subas .env a GitHub.
# Opcion 1 (recomendada en Railway/nube): una sola URL de conexion
MYSQL_URL=mysql://usuario:contrasena@host:3306/corabastos_aux
# Opcion 2 (local): variables separadas (se usan solo si no hay MYSQL_URL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corabastos_aux
DB_USER=root
DB_PASSWORD=
PORT=3000
# Origenes permitidos por CORS (separados por coma). Vacio = cualquier origen.
CORS_ORIGINS=
